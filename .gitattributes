# Ensure shell scripts always use LF line endings
*.sh text eol=lf

# Windows batch files use CRLF
*.bat text eol=crlf

# PowerShell scripts use CRLF
*.ps1 text eol=crlf

# Source code files use LF
*.go text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.sqlite binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
