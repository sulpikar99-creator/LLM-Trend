# ===========================================
# REQUIRED ENVIRONMENT VARIABLES
# ===========================================

# Database Encryption (32-byte hex key)
# Generate with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# JWT Authentication (32-byte hex key)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-key-here

# ===========================================
# SERVER CONFIGURATION
# ===========================================

# Backend API port
NOFX_BACKEND_PORT=8080

# Frontend port (for CORS configuration)
NOFX_FRONTEND_PORT=3000

# Timezone for logging and timestamps
NOFX_TIMEZONE=Asia/Shanghai

# Gin mode: debug, release, or test
GIN_MODE=debug

# ===========================================
# AI CONFIGURATION - CRITICAL FOR AUTO-TRADING!
# ===========================================

# AI Provider: openai, deepseek, claude, qwen
# Default: deepseek (most cost-effective)
AI_PROVIDER=deepseek

# AI Model (provider-specific)
# OpenAI: gpt-4o-mini, gpt-4o, gpt-4-turbo
# DeepSeek: deepseek-chat, deepseek-coder
# Claude: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# Qwen: qwen-turbo, qwen-plus, qwen-max
AI_MODEL=deepseek-chat

# AI API Key - REQUIRED for auto-trading!
# Without this, traders run in MONITOR-ONLY mode (no trades)
# Get your API key from:
# - OpenAI: https://platform.openai.com/api-keys
# - DeepSeek: https://platform.deepseek.com/api_keys
# - Claude: https://console.anthropic.com/settings/keys
# - Qwen: https://dashscope.console.aliyun.com/
AI_API_KEY=

# Alternative: Provider-specific API keys (overrides AI_API_KEY)
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# QWEN_API_KEY=sk-...

# AI Base URL (optional, defaults set per provider)
# Only change if using custom proxy or different endpoint
# AI_BASE_URL=https://api.deepseek.com/v1

# Maximum tokens for AI responses
AI_MAX_TOKENS=4000

# Temperature (0.0-1.0, higher = more creative)
# Recommended: 0.7 for trading decisions
AI_TEMPERATURE=0.7

# AI request timeout in seconds
AI_REQUEST_TIMEOUT=60

# ===========================================
# BINANCE API CONFIGURATION
# ===========================================

# Production Binance API (DANGER: Real money!)
# Only set these if you're using real trading
BINANCE_API_KEY=
BINANCE_SECRET=

# Binance Testnet API (RECOMMENDED for testing)
# Get your testnet credentials from: https://testnet.binancefuture.com
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=

# ===========================================
# OPTIONAL: TELEGRAM NOTIFICATIONS
# ===========================================

# Telegram bot token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram chat ID (your chat ID or group ID)
TELEGRAM_CHAT_ID=

# ===========================================
# OPTIONAL: LOGGING CONFIGURATION
# ===========================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: json or text
LOG_FORMAT=text

# ===========================================
# OPTIONAL: RATE LIMITING
# ===========================================

# Requests per second per IP (default: 10)
RATE_LIMIT_RPS=10

# Rate limit burst size (default: 20)
RATE_LIMIT_BURST=20

# ===========================================
# OPTIONAL: DATABASE CONFIGURATION
# ===========================================

# Database file path (default: config.db)
DATABASE_PATH=config.db

# ===========================================
# DEVELOPMENT & TESTING
# ===========================================

# Enable debug mode for detailed logs
DEBUG=false

# Skip TLS verification (NEVER use in production)
SKIP_TLS_VERIFY=false
