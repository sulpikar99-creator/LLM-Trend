# ===========================================
# REQUIRED ENVIRONMENT VARIABLES
# ===========================================

# Database Encryption (32-byte hex key)
# Generate with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# JWT Authentication (32-byte hex key)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-key-here

# ===========================================
# SERVER CONFIGURATION
# ===========================================

# Backend API port
NOFX_BACKEND_PORT=8080

# Frontend port (for CORS configuration)
NOFX_FRONTEND_PORT=3000

# Timezone for logging and timestamps
NOFX_TIMEZONE=Asia/Shanghai

# Gin mode: debug, release, or test
GIN_MODE=debug

# ===========================================
# AI CONFIGURATION (PER-USER CONFIGURABLE)
# ===========================================

# Default AI provider (can be overridden per user)
# Options: openai, anthropic, custom
DEFAULT_AI_PROVIDER=openai

# Default AI model
DEFAULT_AI_MODEL=gpt-4

# Maximum tokens for AI responses
AI_MAX_TOKENS=4000

# AI request timeout in seconds
AI_REQUEST_TIMEOUT=30

# ===========================================
# BINANCE API CONFIGURATION
# ===========================================

# Production Binance API (DANGER: Real money!)
# Only set these if you're using real trading
BINANCE_API_KEY=
BINANCE_SECRET=

# Binance Testnet API (RECOMMENDED for testing)
# Get your testnet credentials from: https://testnet.binancefuture.com
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=

# ===========================================
# OPTIONAL: TELEGRAM NOTIFICATIONS
# ===========================================

# Telegram bot token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram chat ID (your chat ID or group ID)
TELEGRAM_CHAT_ID=

# ===========================================
# OPTIONAL: LOGGING CONFIGURATION
# ===========================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: json or text
LOG_FORMAT=text

# ===========================================
# OPTIONAL: RATE LIMITING
# ===========================================

# Requests per second per IP (default: 10)
RATE_LIMIT_RPS=10

# Rate limit burst size (default: 20)
RATE_LIMIT_BURST=20

# ===========================================
# OPTIONAL: DATABASE CONFIGURATION
# ===========================================

# Database file path (default: config.db)
DATABASE_PATH=config.db

# ===========================================
# DEVELOPMENT & TESTING
# ===========================================

# Enable debug mode for detailed logs
DEBUG=false

# Skip TLS verification (NEVER use in production)
SKIP_TLS_VERIFY=false
